{
  "name": "@tom2012/dsh-notes",
  "version": "0.1.0",
  "description": "DSH Web 笔记本插件：左侧「全部笔记本」进主面板浏览全部；右侧栏「笔记本」按当前工作区新建/打开，内容直接渲染在右侧栏。BlockNote 编辑器，blocks JSON 真源 + Markdown 镜像，Agent 可读写同一份数据。",
  "license": "MIT",
  "author": {
    "name": "zbc0315"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbc0315/dsh-notes.git"
  },
  "homepage": "https://github.com/zbc0315/dsh-notes#readme",
  "bugs": {
    "url": "https://github.com/zbc0315/dsh-notes/issues"
  },
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host",
    "client",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node --check src/host/index.js && node --check src/host/store.js && node --check src/host/routes.js && node --check src/host/tools.js && node --check src/host/markdown-blocks.js",
    "selftest": "node test/selftest.mjs",
    "smoke": "node test/client-smoke.mjs",
    "test": "npm run build && npm run check && npm run selftest && npm run smoke && node --test test/markdown-blocks.test.mjs test/store.test.mjs test/routes-lifecycle.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notes",
    "notebook",
    "markdown",
    "blocknote"
  ],
  "devDependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
